# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins, e.g.
# CORS_ORIGIN=https://marketdesign.shop,https://www.marketdesign.shop,https://my-app.vercel.app
CORS_ORIGIN=http://localhost:5173
# Canonical public URL of the web app, used to build links in emails/redirects.
# Falls back to the first CORS origin if not set.
# APP_URL=https://marketdesign.shop

# Database
DB_URI=postgresql://marketplace:marketplace123@localhost:5433/marketplace_diseños
# Production (Neon): use the connection string with sslmode=require, e.g.
# DB_URI=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Used by the test suite when NODE_ENV=test (keeps dev data untouched).
TEST_DB_URI=postgresql://marketplace:marketplace123@localhost:5433/marketplace_disenos_test

# JWT
SECRET_JWT_SEED=change_this_to_a_random_string_of_at_least_64_characters
JWT_EXPIRE_IN=1d

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=marketplace-diseños
R2_PUBLIC_URL=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# OAuth (Marketplace / split). Client ID and Client Secret from "Credenciales de producción".
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Public URL of the API (used for OAuth redirect and MP webhook), e.g. https://api.marketdesign.shop
API_PUBLIC_URL=

# Cloudinary (preview images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Captcha (hCaptcha)
HCAPTCHA_SECRET=

# Resend
RESEND_API_KEY=
OWNER_EMAIL=

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
