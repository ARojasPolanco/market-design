# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
DB_URI=postgresql://marketplace:marketplace123@localhost:5433/marketplace_diseños

# JWT
SECRET_JWT_SEED=change_this_to_a_random_string_of_at_least_64_characters
JWT_EXPIRE_IN=1d

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=marketplace-diseños
R2_PUBLIC_URL=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
OWNER_EMAIL=

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
