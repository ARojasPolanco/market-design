FROM node:22-alpine

RUN apk add --no-cache python3 make g++ fontconfig ttf-dejavu

WORKDIR /app

# Disable husky git hooks during install (no .git in the image)
ENV HUSKY=0

COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages/shared/package*.json ./packages/shared/

# Install API deps without lifecycle scripts (avoids the root husky `prepare`),
# then rebuild the native modules so sharp (prebuilt) and bcrypt (compiled) work.
RUN npm install --workspace=apps/api --ignore-scripts
RUN npm rebuild sharp bcrypt

COPY apps/api ./apps/api
COPY packages/shared ./packages/shared

WORKDIR /app/apps/api

ENV NODE_ENV=production

EXPOSE 3000

CMD ["npm", "start"]
